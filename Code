# Superpixel segmentation parameters
n_segments = 100  # Adjust as needed
compactness = 10  # Adjust as needed

# GLCM parameters
distances = [1, 2, 3]
angles = [0, np.pi/4, np.pi/2, 3*np.pi/4]

# Process and display glaucoma images
for image_file in os.listdir(glaucoma_folder):
    if image_file.endswith('.jpg'):
        image_path = os.path.join(glaucoma_folder, image_file)
        segmented_image, segments = apply_superpixel_segmentation(image_path, n_segments, compactness)

        # Extract GLCM features from superpixel regions
        glcm_features = extract_glcm_features_from_superpixel(segmented_image, segments, distances, angles)

        # Combine GLCM features for this image
        combined_features = np.mean(glcm_features, axis=0)

        # Display the segmented image
        plt.figure(figsize=(8, 8))
        plt.imshow(segmented_image)
        plt.title('Glaucoma Image')
        plt.axis('off')
        plt.show()

        # Print combined GLCM features for this image
        print("Combined GLCM Features for", image_file)
        print(combined_features)

