# Function to apply the Gabor filter and display the filtered image
def apply_gabor_filter(image, ksize, sigma, theta, lambda_, gamma):
    gabor_kernel = cv2.getGaborKernel(
        (ksize, ksize), sigma, theta, lambda_, gamma, 0, ktype=cv2.CV_32F
    )
    filtered_image = cv2.filter2D(image, cv2.CV_8UC3, gabor_kernel)

    return filtered_image

