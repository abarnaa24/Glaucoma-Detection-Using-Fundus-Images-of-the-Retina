import os
import cv2
import numpy as np
import matplotlib.pyplot as plt
from skimage.segmentation import slic
from skimage.color import label2rgb
from skimage.feature import graycomatrix, greycoprops

# Function for superpixel segmentation
def apply_superpixel_segmentation(image_path, n_segments, compactness):
    # Load the image
    image = cv2.imread(image_path)

    # Convert the image to RGB format
    image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

    # Apply superpixel segmentation
    segments = slic(image_rgb, n_segments=n_segments, compactness=compactness)

    # Create a superpixel image
    superpixel_image = label2rgb(segments, image_rgb, kind='avg')

    return superpixel_image, segments

# Function to extract GLCM features from a superpixel region
def extract_glcm_features_from_superpixel(image, segments, distances, angles):
    glcm_features = []

    for segment_id in np.unique(segments):
        # Create a mask for the current superpixel segment
        mask = (segments == segment_id)

        # Convert the segment to grayscale
        segment_gray = cv2.cvtColor((image * mask[:, :, np.newaxis]).astype(np.uint8), cv2.COLOR_RGB2GRAY)

        # Compute GLCM for the superpixel segment
        glcm = graycomatrix(segment_gray, distances=distances, angles=angles, symmetric=True, normed=True)

        # Calculate GLCM properties
        contrast = greycoprops(glcm, 'contrast')
        correlation = greycoprops(glcm, 'correlation')
        energy = greycoprops(glcm, 'energy')
        homogeneity = greycoprops(glcm, 'homogeneity')

        # Append GLCM features to the list
        glcm_features.append(np.concatenate([contrast.ravel(), correlation.ravel(), energy.ravel(), homogeneity.ravel()]))

    return glcm_features

